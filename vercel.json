{
  "rewrites": [
    { "source": "/livre/:slug",   "destination": "/api/preview?slug=:slug&type=book" },
    { "source": "/article/:slug", "destination": "/api/preview?slug=:slug&type=article" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/campay.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-lib/**"
    },
    "api/generate-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-lib/**"
    }
  }
}
